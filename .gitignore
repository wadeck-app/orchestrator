node_modules/
dist/
# Config dir for scripts/dev-server.mjs: its own state.json, audit log and job
# logs, so a dev build never writes into ~/.config/orchestrator.
.dev-config/
dist-bundle/
# tsc's incremental build cache. It was tracked, so it showed as modified after every
# build and sat in every diff and every commit's file list.
*.tsbuildinfo
# Output of orch-server/scripts/copy-app.mjs, which deletes and rewrites the whole
# directory on every build. The sibling destination orch-server/public was already
# ignored, so the same generated files were tracked in one place and not the other.
# It stays in the published package: `files` in package.json wins over .gitignore,
# verified with npm pack.
packages/orchestrator-cli/server/public/
.env.local
*.log
.idea/
# Crash dump MSYS2 bash drops in the CWD. It was committed by accident in 4aa24ca and then
# showed as modified after every shell crash, putting a diff nobody wrote into every commit.
*.stackdump
# Output of the w-learning session-end hook, which rewrites both files every time a session ends.
# Their durable content was merged into .claude/kb/lessons-learned.md, which is the one lessons file
# for this project. Ignored rather than deleted because the hook recreates them regardless -- the
# path is hardcoded in a plugin cache directory -- and tracking a file no human edits put a diff
# nobody wrote into every commit and made the two files drift.
.claude/lessons-learned.md
.claude/lessons-recommendations.md
# Session scratch: browser screenshots taken to verify a change, and the message file `git commit -F`
# needs because the commit guardrail rejects heredocs. Useful while working, worthless afterwards, and
# eight of them had accumulated untracked before anyone noticed.
.claude/tmp-*
# Single-use codemods, kept out of the tree once they have run. The durable ones have real names.
scripts/tmp-*
# Bypass state, written only by the guardrails plugin after the user approves. Machine-local by
# definition, and committing it would hand another checkout someone else's approvals.
.claude/w-guardrails/