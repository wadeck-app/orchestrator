    "dev:stop": "node scripts/dev-server.mjs --stop"
  },
  "dependencies": {
    "@wadeck-app/dsl-renderer": "^2026.10.17-099-ff0571d7",
    "@wadeck-app/dsl-ui": "^2026.10.3-085-45c50664"
  },
  "devDependencies": {
    "@wadeck-app/violations-rules": "^2026.10.17-129-a3020ddc"
  }
}
