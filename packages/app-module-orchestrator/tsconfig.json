{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["node"],
    "paths": {
      // orch-ui's components are imported by orch-app's generated entries through relative src paths, so
      // the package name must land on the same files: a second copy (dist/) would hold its own
      // configureOrchUi state and the components would keep calling /api instead of the module's API.
      // esbuild (app-core-cli package) reads this too.
      "@wadeck-app/orch-ui": ["../orch-ui/src/index.ts"]
    }
  },
  "include": ["src/**/*"]
}
