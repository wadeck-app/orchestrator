{
  "name": "@wadeck-app/app-module-orchestrator",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "files": ["dist-module"],
  "exports": {
    "./moduleConfig": "./src/commons/moduleConfig.ts",
    "./routes": "./src/backend/routes.ts"
  },
  "scripts": {
    "css": "npm run css --workspace=@wadeck-app/dsl-lib-orch",
    "check": "app-core-cli check .",
    "package": "npm run css && app-core-cli package .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --bail=1",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@wadeck-app/dsl-lib-orch": "*",
    "@wadeck-app/orch-core": "*",
    "@wadeck-app/shared-cli": "latest"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.0",
    "@wadeck-app/app-core-cli": "latest",
    "@wadeck-app/app-core-sdk": "latest",
    "fastify": "^5.0.0",
    "typescript": "*",
    "vitest": "*"
  },
  "engines": {
    "node": ">=22"
  }
}
