{
  "id": "orchestrator",
  "dslLib": {
    "shared": {
      "react": "^19",
      "react-router-dom": "^7",
      "@wadeck-app/dsl-ui": ">=2026.10.3-0",
      "@wadeck-app/dsl-renderer": ">=2026.10.14-0"
    }
  },
  "extensionPoints": [
    {
      "kind": "widget",
      "slot": "dashboard",
      "label": "Orchestrator",
      "view": { "type": "path", "value": "./src/dsl-views/status-widget.yaml" },
      "width": 4
    },
    {
      "kind": "widget",
      "slot": "navbar",
      "label": "Job counts",
      "view": { "type": "path", "value": "./src/dsl-views/navbar-stats.yaml" }
    },
    {
      "kind": "widget",
      "slot": "overlay",
      "label": "Failures",
      "view": { "type": "path", "value": "./src/dsl-views/failure-overlay.yaml" }
    },
    {
      "kind": "page",
      "slot": "nav",
      "label": "Jobs",
      "path": "/",
      "view": { "type": "path", "value": "./src/dsl-views/jobs.yaml" }
    },
    {
      "kind": "page",
      "slot": "nav",
      "label": "Schedule",
      "path": "/schedule",
      "view": { "type": "path", "value": "./src/dsl-views/schedule.yaml" }
    },
    {
      "kind": "page",
      "slot": "nav",
      "label": "Audit",
      "path": "/audit",
      "view": { "type": "path", "value": "./src/dsl-views/audit.yaml" }
    },
    {
      "kind": "page",
      "slot": "route",
      "label": "New job",
      "path": "/jobs/new",
      "view": { "type": "path", "value": "./src/dsl-views/job-new.yaml" }
    },
    {
      "kind": "page",
      "slot": "route",
      "label": "Job",
      "path": "/jobs/:id",
      "view": { "type": "path", "value": "./src/dsl-views/job.yaml" }
    },
    {
      "kind": "page",
      "slot": "route",
      "label": "Edit job",
      "path": "/jobs/:id/edit",
      "view": { "type": "path", "value": "./src/dsl-views/job-edit.yaml" }
    },
    {
      "kind": "page",
      "slot": "route",
      "label": "Job logs",
      "path": "/jobs/:id/logs",
      "view": { "type": "path", "value": "./src/dsl-views/job-logs.yaml" }
    }
  ]
}
