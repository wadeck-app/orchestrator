{
  "name": "@wadeck-app/orchestrator-cli",
  "version": "0.2.0",
  "description": "Cross-platform job orchestrator daemon and CLI",
  "main": "dist/orchestrator.cjs",
  "bin": {
    "orch": "bin/orch.js",
    "orchestrator": "bin/orch.js"
  },
  "files": [
    "bin/",
    "dist/orchestrator.cjs",
    "dist/orchestrator-cli.cjs",
    "dist/orchestrator-updater.cjs",
    "server/",
    "app-module/",
    "package.json"
  ],
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "bundle": "npx tsx scripts/bundle.ts",
    "pretest": "node scripts/clean-test-temp.cjs",
    "clean:test-temp": "node scripts/clean-test-temp.cjs",
    "test": "node --test --test-timeout=120000 --require tsx/cjs --require ./test/helpers/isolate-config-dir.js \"test/**/*.test.js\"",
    "test:w": "node --test --watch --require tsx/cjs --require ./test/helpers/isolate-config-dir.js \"test/**/*.test.js\"",
    "test:time": "node scripts/time-tests.mjs",
    "build-launcher": "node ci/scripts/build-launcher.mjs",
    "build-tray": "npx tsx scripts/build-tray-binary.ts",
    "build-supervisor": "npx tsx scripts/build-supervisor-binary.ts",
    "gen-icons": "npx tsx scripts/generate-icons.ts",
    "preversion": "echo 'Bump via CI -- use npm version in CI only' && exit 1",
    "clean": "rimraf dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wadeck-app/orchestrator.git"
  },
  "optionalDependencies": {
    "@wadeck-app/orchestrator-cli-darwin-arm64": ">=0.0.0-0",
    "@wadeck-app/orchestrator-cli-darwin-x64": ">=0.0.0-0",
    "@wadeck-app/orchestrator-cli-linux-arm64": ">=0.0.0-0",
    "@wadeck-app/orchestrator-cli-linux-x64": ">=0.0.0-0",
    "@wadeck-app/orchestrator-cli-win32-x64": ">=0.0.0-0"
  },
  "publishConfig": {
    "@wadeck-app:registry": "https://npm.pkg.github.com/",
    "access": "public"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/static": "^8.0.0",
    "@wadeck-app/app-core-sdk": ">=2026.10.22-075-f7ea6949",
    "@wadeck-app/queue-sdk": ">=2026.10.24-190-aa15e847",
    "@wadeck-app/shared-cli": "^2026.10.25-044-51609e11",
    "@wadeck-app/shared-updater": ">=2026.10.25-020-6cb52900",
    "@wadeck-app/singleton-daemon-kit": "2026.10.26-100-8909a9d1",
    "fastify": "^5.0.0",
    "node-cron": "^4.6.0",
    "pidtree": "^1.0.0",
    "pidusage": "^4.1.0",
    "semver": "^7.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/semver": "^7.8.0",
    "ajv": "^8.17.0",
    "esbuild": "^0.25.12",
    "rimraf": "^6.1.3",
    "sharp": "^0.33.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
