package main

import (
	"os"
	"strings"

	launcher "wadeck.ch/singleton-daemon-kit/go-launcher"
)

func configDirFromArgs(args []string) string {
	for i, arg := range args {
		if arg == "--config" && i+1 < len(args) {
			return args[i+1]
		}
		if strings.HasPrefix(arg, "--config=") {
			return strings.TrimPrefix(arg, "--config=")
		}
	}
	for _, arg := range args {
		if !strings.HasPrefix(arg, "--") {
			return arg
		}
	}
	return launcher.DefaultConfigDir("{{.DefaultConfigDir}}")
}

func main() {
	launcher.Run(launcher.Config{
		ConfigDir: configDirFromArgs(os.Args[1:]),
		// Passed through unresolved. The SDK resolves it as an npm package specifier by
		// walking up node_modules, which is what lets this launcher -- published in its own
		// platform package -- find the bundle in the main package whether npm hoisted the
		// platform package next to it or nested it underneath. Joining it to the exe
		// directory here would destroy the specifier and tie start-at-login to one layout.
		NodeScript: "{{.NodeScript}}",
		AppName:    "{{.AppName}}",
		CLIFlags:   []string{
			{{range .CLIFlags}}{{end}}
		},
		SilentFlags: []string{
			{{range .SilentFlags}}{{end}}
		},
		UpdateCmd: []string{
			{{range .UpdateCmd}}{{end}}
		},
	})
}
