{
  "name": "@wadeck-app/orch-server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run typecheck && node scripts/bundle.mjs",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "copy-app": "node scripts/copy-app.mjs",
    "build:full": "npm run build && npm run copy-app"
  },
  "dependencies": {
    "fastify": "^5.0.0",
    "@fastify/static": "^8.0.0",
    "@fastify/cors": "^10.0.0",
    "@wadeck-app/orch-core": "*",
    "@wadeck-app/singleton-daemon-kit": "latest"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "typescript": "*",
    "tsx": "*",
    "vitest": "*",
    "@types/node": "*"
  }
}
