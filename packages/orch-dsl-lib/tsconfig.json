{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["node"],
    "paths": {
      // The generated entries import orch-ui's components through relative src paths, so the package name
      // must land on the same files: a second copy (dist/) would hold its own configureOrchUi state and the
      // components would keep calling /api instead of the module's API. esbuild (app-core-cli package) reads
      // this too, for the files of this package.
      "@wadeck-app/orch-ui": ["../orch-ui/src/index.ts"]
    }
  },
  "include": ["src/**/*", "scripts/**/*", "tailwind.config.ts", "vitest.config.ts"]
}
